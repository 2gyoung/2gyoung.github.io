---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Projects · 2gyoung.dev"
  description="제가 만든 프로젝트들"
>
  <header class="mb-10">
    <h1 class="text-3xl font-bold tracking-tight md:text-4xl">Projects</h1>
    <p class="mt-2 text-neutral-600 dark:text-neutral-400">
      만들었거나 참여한 프로젝트를 모아둔 곳입니다.
    </p>
  </header>

  {
    projects.length === 0 ? (
      <p class="text-neutral-500">아직 등록된 프로젝트가 없습니다.</p>
    ) : (
      <ul class="grid gap-6 md:grid-cols-2">
        {projects.map((project) => (
          <li>
            <a
              href={`/projects/${project.id}/`}
              class="group flex h-full flex-col rounded-xl border border-neutral-200 p-5 transition-colors hover:border-neutral-400 dark:border-neutral-800 dark:hover:border-neutral-600"
            >
              {project.data.heroImage && (
                <Image
                  src={project.data.heroImage}
                  alt=""
                  width={600}
                  height={338}
                  class="mb-4 aspect-video rounded-lg object-cover"
                />
              )}
              <h2 class="text-lg font-semibold group-hover:text-accent">
                {project.data.title}
              </h2>
              <p class="mt-1 flex-1 text-sm text-neutral-600 dark:text-neutral-400">
                {project.data.description}
              </p>
              {project.data.techStack.length > 0 && (
                <ul class="mt-3 flex flex-wrap gap-1">
                  {project.data.techStack.map((tech) => (
                    <li class="rounded bg-neutral-100 px-2 py-0.5 text-xs text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300">
                      {tech}
                    </li>
                  ))}
                </ul>
              )}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
