---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: project,
  }));
}

const project = Astro.props;
const { Content } = await render(project);
const { title, description, pubDate, heroImage, techStack, demoUrl, repoUrl } =
  project.data;
---

<BaseLayout title={`${title} · Projects`} description={description} image={heroImage}>
  <article>
    <header class="mb-8">
      <p class="text-sm text-neutral-500">
        <FormattedDate date={pubDate} />
      </p>
      <h1 class="mt-1 text-3xl font-bold tracking-tight md:text-4xl">{title}</h1>
      <p class="mt-3 text-lg text-neutral-600 dark:text-neutral-400">{description}</p>

      {
        techStack.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-1">
            {techStack.map((tech) => (
              <li class="rounded bg-neutral-100 px-2 py-0.5 text-xs text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300">
                {tech}
              </li>
            ))}
          </ul>
        )
      }

      {
        (demoUrl || repoUrl) && (
          <div class="mt-4 flex gap-3">
            {demoUrl && (
              <a
                href={demoUrl}
                target="_blank"
                rel="noreferrer"
                class="rounded-lg bg-neutral-950 px-4 py-2 text-sm font-medium text-white hover:bg-neutral-800 dark:bg-white dark:text-neutral-950 dark:hover:bg-neutral-200"
              >
                Live Demo
              </a>
            )}
            {repoUrl && (
              <a
                href={repoUrl}
                target="_blank"
                rel="noreferrer"
                class="rounded-lg border border-neutral-300 px-4 py-2 text-sm font-medium hover:bg-neutral-100 dark:border-neutral-700 dark:hover:bg-neutral-800"
              >
                Repository
              </a>
            )}
          </div>
        )
      }
    </header>

    {
      heroImage && (
        <Image
          src={heroImage}
          alt=""
          width={1200}
          height={675}
          class="mb-8 aspect-video w-full rounded-xl object-cover"
        />
      )
    }

    <div class="prose prose-neutral dark:prose-invert max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
