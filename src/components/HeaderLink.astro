---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const hrefPath = String(href).replace(/\/$/, '') || '/';
const currentTop = '/' + (subpath?.[0] ?? '');
const isActive = hrefPath === pathname.replace(/\/$/, '') || hrefPath === currentTop;
---

<a
  href={href}
  class:list={[
    'px-3 py-2 text-sm font-medium transition-colors',
    'text-neutral-600 hover:text-neutral-950',
    'dark:text-neutral-400 dark:hover:text-neutral-50',
    { 'text-neutral-950! dark:text-neutral-50! font-semibold': isActive },
    className,
  ]}
  {...props}
>
  <slot />
</a>
